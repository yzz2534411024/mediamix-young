-- 性能指标事件表 — 原始埋点事件持久化
CREATE TABLE MetricsEvents (
    id TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL,
    videoId TEXT NOT NULL,
    eventType TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    payloadJson TEXT NOT NULL DEFAULT '{}',
    uploaded INTEGER NOT NULL DEFAULT 0
);

-- 查询所有事件
selectAll:
SELECT * FROM MetricsEvents;

-- 查询未上传的事件（限制数量）
selectUnuploaded:
SELECT * FROM MetricsEvents WHERE uploaded = 0 LIMIT ?;

-- 插入事件
insert:
INSERT INTO MetricsEvents (id, sessionId, videoId, eventType, timestamp, payloadJson, uploaded)
VALUES (?, ?, ?, ?, ?, ?, 0);

-- 标记事件为已上传
markUploaded:
UPDATE MetricsEvents SET uploaded = 1 WHERE id IN ?;

-- 删除已上传的事件
deleteUploaded:
DELETE FROM MetricsEvents WHERE uploaded = 1;

-- 删除过期事件（时间戳早于指定值）
deleteOlderThan:
DELETE FROM MetricsEvents WHERE timestamp < ?;
